{
  "name": "jme-jwe-scs-ui",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "scripts": {
    "start": "ng serve",
    "build": "npm run check-licenses && npm run generateLicenseFile && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "npm run lint -- --fix",
    "build-prod": "npm run check-licenses && npm run generateLicenseFile && ng build --configuration production",
    "test:ci": "ng test --watch=false",
    "check-licenses": "jeap-frontend-license-checker",
    "generateLicenseFile": "jeap-frontend-license-checker notices && jeap-frontend-license-checker notices --out src/assets/THIRD-PARTY-LICENSES.md --texts folder --texts-dir third-party-licenses"
  },
  "private": true,
  "packageManager": "npm@12.2.2",
  "dependencies": {
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/material": "22.2.6",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@jeap/jeap-jwe-client": "^1.2.0",
    "@ngx-translate/core": "18.1.0",
    "@oblique/oblique": "16.0.4",
    "@popperjs/core": "^2.0.0",
    "angular-oauth2-oidc": "22.0.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-builders/jest": "22.0.1",
    "@angular-devkit/build-angular": "22.0.9",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.4",
    "@angular/platform-browser-dynamic": "22.2.4",
    "@eslint/js": "^10.0.0",
    "@jeap/jeap-frontend-license-checker": "^1.0.1",
    "@oblique/toolchain": "16.0.4",
    "@types/jest": "^30.0.0",
    "ajv": "^8.0.0",
    "ajv-formats": "^3.0.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.30.1"
  },
  "overrides": {
    "fast-uri": "4.2.3"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
